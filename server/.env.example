# Portfolio Admin — copy this to server/.env and fill in values
# Or run: node server/scripts/setup.js  (generates .env automatically)

# bcrypt hash of your admin password (generated by setup.js)
ADMIN_HASH=

# Random secret for signing JWTs — minimum 32 characters
JWT_SECRET=

# Image storage backend: "local" (default) or "cloudinary"
IMAGE_STORAGE=local

# Cloudinary credentials (only needed if IMAGE_STORAGE=cloudinary)
# Get yours at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server port (default: 3001)
# PORT=3001
