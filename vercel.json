{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/content/[type].js": {
      "includeFiles": "server/data/**"
    }
  },
  "rewrites": [
    { "source": "/case-study/yonder-ai", "destination": "/yonder-ai/case-study-hosted.html" },
    { "source": "/case-study/yonder-ai/prototype", "destination": "/yonder-ai/prototype-hosted.html" },
    { "source": "/case-study/yonder-ai/design-system", "destination": "/yonder-ai/design-system-hosted.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
